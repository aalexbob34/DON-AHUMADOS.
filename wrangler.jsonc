{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "don-ahumados",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Solo estas rutas pasan por el Worker; los archivos estáticos (CSS, JS, imágenes) los sirve Cloudflare sin costo.
    "run_worker_first": ["/api/*", "/uploads/*", "/", "/carta", "/tienda", "/carrito", "/checkout", "/cuenta", "/ingresar", "/pedido/*", "/seguimiento", "/nosotros", "/producto/*", "/robots.txt", "/sitemap.xml", "/admin", "/admin/"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "don-ahumados-db", "database_id": "REEMPLAZA-CON-EL-ID-DE-TU-BASE-DE-DATOS", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "don-ahumados-fotos" }
  ],
  "vars": {
    "SITE_URL": "",
    "ADMIN_USER": "alex"
  }
}
