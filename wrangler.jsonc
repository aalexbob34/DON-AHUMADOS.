{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "don-ahumados",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Solo estas rutas pasan por el Worker; los archivos estáticos (CSS, JS, imágenes) los sirve Cloudflare sin costo.
    "run_worker_first": ["/api/*", "/uploads/*", "/", "/carta", "/tienda", "/carrito", "/checkout", "/cuenta", "/ingresar", "/pedido/*", "/seguimiento", "/nosotros", "/producto/*", "/robots.txt", "/sitemap.xml", "/admin", "/admin/"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "donahumados", "database_id": "35dc5611-7c5b-48dc-a8ed-4cc61963562d", "migrations_dir": "migrations" }
  ],
  "vars": {
    "SITE_URL": "",
    "ADMIN_USER": "alex"
  }
}
